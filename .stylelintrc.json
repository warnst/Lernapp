{
  "extends": ["stylelint-config-standard", "stylelint-config-css-modules"],
  "overrides": [
    {
      "files": ["**/*.module.css"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          { "message": "CSS-Module-Klassen in camelCase (styles.withNav)" }
        ]
      }
    }
  ]
}
